#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../../../../../prisma@7.3.0_@types+react@19.2.10_react-dom@19.2.4_react@19.2.4__react@19.2.4_typescript@5.9.3/node_modules/prisma/build/index.js" "$@"
else
  exec node  "$basedir/../../../../../../prisma@7.3.0_@types+react@19.2.10_react-dom@19.2.4_react@19.2.4__react@19.2.4_typescript@5.9.3/node_modules/prisma/build/index.js" "$@"
fi
